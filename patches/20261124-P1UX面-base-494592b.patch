diff --git a/app/src/test/java/me/rerere/rikkahub/data/ai/mcp/server/LocalApprovalBridgeVisibilityTest.kt b/app/src/test/java/me/rerere/rikkahub/data/ai/mcp/server/LocalApprovalBridgeVisibilityTest.kt
new file mode 100644
index 000000000..04ebb5480
--- /dev/null
+++ b/app/src/test/java/me/rerere/rikkahub/data/ai/mcp/server/LocalApprovalBridgeVisibilityTest.kt
@@ -0,0 +1,63 @@
+package me.rerere.rikkahub.data.ai.mcp.server
+
+import android.Manifest
+import android.app.Application
+import android.app.Notification
+import android.app.NotificationManager
+import android.content.Context
+import kotlinx.coroutines.cancelAndJoin
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.test.runCurrent
+import kotlinx.coroutines.test.runTest
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+import me.rerere.ai.core.Tool
+import org.junit.Assert.assertEquals
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+
+/**
+ * 审批通知的锁屏可见性回归测试。
+ *
+ * [LocalApprovalBridge] 的通知内容是工具入参摘要——VISIBILITY_PUBLIC 时锁屏上
+ * 明文可见工具参数。断言发出的通知是 VISIBILITY_PRIVATE，随系统“锁屏隐藏敏感
+ * 内容”遮蔽。
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34], application = Application::class)
+class LocalApprovalBridgeVisibilityTest {
+    @Test
+    fun `approval notification is private on the lock screen`() = runTest {
+        val context = RuntimeEnvironment.getApplication()
+        // SDK 34 上 postApprovalNotification 先查 POST_NOTIFICATIONS 权限，未授
+        // 权时直接返回不发通知：测试里先授给应用，否则断言不到任何通知。
+        shadowOf(context).grantPermissions(Manifest.permission.POST_NOTIFICATIONS)
+        val bridge = LocalApprovalBridge(context)
+        val tool = Tool(
+            name = "visibility_probe_tool",
+            description = "probe",
+            needsApproval = { true },
+            execute = { emptyList() },
+        )
+        // requireApproval 在发通知后挂起等决策：先让它跑到发通知处，断言后再取消。
+        val job = launch {
+            bridge.requireApproval(
+                tool,
+                buildJsonObject { put("secret_arg", "do-not-show-on-lock-screen") },
+                "req-visibility-1",
+            )
+        }
+        runCurrent()
+
+        val nm = context.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
+        val posted = shadowOf(nm).allNotifications
+        assertEquals(1, posted.size)
+        assertEquals(Notification.VISIBILITY_PRIVATE, posted.single().visibility)
+
+        job.cancelAndJoin()
+    }
+}
diff --git a/app/src/test/java/me/rerere/rikkahub/service/RetryLastGenerationTest.kt b/app/src/test/java/me/rerere/rikkahub/service/RetryLastGenerationTest.kt
new file mode 100644
index 000000000..bb674e915
--- /dev/null
+++ b/app/src/test/java/me/rerere/rikkahub/service/RetryLastGenerationTest.kt
@@ -0,0 +1,76 @@
+package me.rerere.rikkahub.service
+
+import kotlin.uuid.Uuid
+import me.rerere.ai.core.MessageRole
+import me.rerere.ai.ui.UIMessage
+import me.rerere.ai.ui.UIMessagePart
+import me.rerere.rikkahub.data.model.Conversation
+import me.rerere.rikkahub.data.model.MessageNode
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+/**
+ * [findLastUserMessage]：错误卡片「重试」的锚点查找。纯函数，不碰 ChatService。
+ */
+class RetryLastGenerationTest {
+    private fun user(text: String) =
+        UIMessage(role = MessageRole.USER, parts = listOf(UIMessagePart.Text(text)))
+
+    private fun assistant(text: String) =
+        UIMessage(role = MessageRole.ASSISTANT, parts = listOf(UIMessagePart.Text(text)))
+
+    private fun conversation(vararg nodes: MessageNode) =
+        Conversation(assistantId = Uuid.random(), messageNodes = nodes.toList())
+
+    @Test
+    fun `single user message is returned`() {
+        val message = user("hello")
+        assertEquals(message, findLastUserMessage(conversation(MessageNode.of(message))))
+    }
+
+    @Test
+    fun `assistant reply after user message does not shadow it`() {
+        val message = user("hello")
+        val found = findLastUserMessage(
+            conversation(MessageNode.of(message), MessageNode.of(assistant("hi"))),
+        )
+        assertEquals(message, found)
+    }
+
+    @Test
+    fun `last user message wins among several turns`() {
+        val first = user("first")
+        val second = user("second")
+        val found = findLastUserMessage(
+            conversation(
+                MessageNode.of(first),
+                MessageNode.of(assistant("reply 1")),
+                MessageNode.of(second),
+                MessageNode.of(assistant("reply 2")),
+            ),
+        )
+        assertEquals(second, found)
+    }
+
+    @Test
+    fun `no user message returns null`() {
+        assertNull(
+            findLastUserMessage(conversation(MessageNode.of(assistant("hi")))),
+        )
+    }
+
+    @Test
+    fun `empty conversation returns null`() {
+        assertNull(findLastUserMessage(conversation()))
+    }
+
+    @Test
+    fun `empty node is skipped instead of throwing`() {
+        val message = user("hello")
+        val found = findLastUserMessage(
+            conversation(MessageNode(messages = emptyList()), MessageNode.of(message)),
+        )
+        assertEquals(message, found)
+    }
+}
