diff --git a/.github/workflows/02-release.yml b/.github/workflows/02-release.yml
index 10c8e60f7..816cfa20b 100644
--- a/.github/workflows/02-release.yml
+++ b/.github/workflows/02-release.yml
@@ -146,6 +146,16 @@ jobs:
           done
           ls -la
 
+      - name: 生成发布产物 SHA256SUMS
+        run: |
+          cd app/build/outputs/apk
+          : > SHA256SUMS
+          for apk in release/*.apk */release/*.apk; do
+            [ -f "$apk" ] || continue
+            sha256sum "$apk" >> SHA256SUMS
+          done
+          cat SHA256SUMS
+
       - name: 创建/更新 Release 并上传
         run: |
           TAG="${{ steps.ver.outputs.tag }}"
@@ -176,5 +186,6 @@ jobs:
             [ -f "$apk" ] || continue
             gh release upload "$TAG" "$apk" --clobber
           done
+          gh release upload "$TAG" SHA256SUMS --clobber
         env:
           GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
