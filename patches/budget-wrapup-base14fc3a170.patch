+        // 旧逻辑从流开始计时，90 秒上限在这里早已撞上，总结零文本就被断流。
+        val start = 1_000_000L
+        assertFalse(isStreamCapExceeded(true, start + 205_000L, start, start + 200_000L))
+    }
