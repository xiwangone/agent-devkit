+                            put("name", "Content-Type")
+                            put("value", "application/json")
+                        })
+                    })
+                })
+            })
+            put("mcpServers", buildJsonArray {
+                add(buildJsonObject {
+                    put("commonOptions", buildJsonObject {
+                        put("headers", buildJsonArray {
+                            add(buildJsonObject {
+                                put("first", "Authorization")
+                                put("second", "Bearer <redacted>")
+                            })
