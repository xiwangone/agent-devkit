+            root.getBoundsInScreen(rect)
+            val cx = (rect.left + rect.right) / 2f
+            val cy = (rect.top + rect.bottom) / 2f
+            val w = (rect.width() / 3f).coerceAtLeast(100f)
+            val h = (rect.height() / 3f).coerceAtLeast(100f)
+            val (sx, sy, ex, ey) = when (direction) {
