@@ -0,0 +1,92 @@
+package me.rerere.ai.ui
+
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertSame
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class TextTruncationTest {
+    // ---- truncateText ----
+
+    @Test
+    fun `short text is returned unchanged`() {
+        assertEquals("hello", truncateText("hello", 10))
+    }
+
+    @Test
+    fun `text at the limit is returned unchanged`() {
+        assertEquals("hello", truncateText("hello", 5))
+    }
+
+    @Test
+    fun `overlong text keeps the head and appends the marker`() {
+        assertEquals("hello\n…[truncated]", truncateText("hello world", 5))
+    }
+
+    @Test
+    fun `custom marker is used`() {
+        assertEquals("hel…<cut>", truncateText("hello", 3, "…<cut>"))
+    }
+
+    // ---- truncateTextParts ----
+
+    @Test
+    fun `parts within the limit are returned as the same list`() {
+        val parts = listOf<UIMessagePart>(
+            UIMessagePart.Text("ab"),
+            UIMessagePart.Image(url = "file:///x.png"),
+            UIMessagePart.Text("cd"),
+        )
+        assertSame(parts, truncateTextParts(parts, 10))
+    }
+
+    @Test
+    fun `overlong parts share one budget in order and keep non-text parts`() {
+        val image = UIMessagePart.Image(url = "file:///x.png")
+        val parts = listOf<UIMessagePart>(
+            UIMessagePart.Text("abcdef"),
+            image,
+            UIMessagePart.Text("ghijkl"),
+        )
+        val result = truncateTextParts(parts, 8)
+        assertEquals(3, result.size)
+        assertEquals("abcdef", (result[0] as UIMessagePart.Text).text)
+        assertSame(image, result[1])
+        assertEquals("gh\n…[truncated]", (result[2] as UIMessagePart.Text).text)
+    }
+
+    @Test
+    fun `parts after the budget is exhausted are dropped and the marker goes on the last kept text part`() {
+        val parts = listOf<UIMessagePart>(
+            UIMessagePart.Text("abc"),
+            UIMessagePart.Text("def"),
+            UIMessagePart.Text("ghi"),
+        )
+        val result = truncateTextParts(parts, 6)
+        assertEquals(2, result.size)
+        assertEquals("abc", (result[0] as UIMessagePart.Text).text)
+        assertEquals("def\n…[truncated]", (result[1] as UIMessagePart.Text).text)
+    }
+
+    @Test
+    fun `truncated text part keeps its metadata`() {
+        val metadata = buildJsonObject { put("kind", "diff") }
+        val parts = listOf<UIMessagePart>(UIMessagePart.Text("abcdef", metadata))
+        val result = truncateTextParts(parts, 3)
+        val text = result.single() as UIMessagePart.Text
+        assertEquals("abc\n…[truncated]", text.text)
+        assertEquals(metadata, text.metadata)
+    }
+
+    @Test
+    fun `empty parts stay empty`() {
+        assertTrue(truncateTextParts(emptyList(), 10).isEmpty())
+    }
+
+    @Test
+    fun `diff marker carries the limit`() {
+        assertEquals("…<diff truncated: exceeds 32768 chars>", diffTruncationMarker(32768))
+    }
+}
