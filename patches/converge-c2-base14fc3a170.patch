+package me.rerere.rikkahub.data.ai.tools
+
+import android.app.Application
+import android.os.Looper
+import androidx.datastore.preferences.core.PreferenceDataStoreFactory
+import androidx.datastore.preferences.preferencesDataStoreFile
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.async
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.runBlocking
+import me.rerere.ai.provider.Model
+import me.rerere.rikkahub.AppScope
+import me.rerere.rikkahub.data.datastore.ProviderCredentialCipher
+import me.rerere.rikkahub.data.datastore.SettingsStore
+import me.rerere.rikkahub.data.datastore.SyntheticSettingsKeyStore
+import me.rerere.rikkahub.data.datastore.SyntheticSettingsSecurityProvider
+import me.rerere.rikkahub.data.event.AppEventBus
+import me.rerere.tts.provider.TTSManager
+import me.rerere.tts.provider.TTSProviderSetting
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+import java.security.Security
+import javax.crypto.KeyGenerator
+
+/**
+ * text_to_speech 工具的 systemPrompt 钩子：按当前选中的 TTS provider 注入语气标记引导。
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34], manifest = Config.NONE, application = Application::class)
+class TtsToolSystemPromptTest {
+    private val context: Application = RuntimeEnvironment.getApplication()
+    private val dataStoreScope = CoroutineScope(Dispatchers.Default)
+    private val dataStore = PreferenceDataStoreFactory.create(scope = dataStoreScope) {
+        context.preferencesDataStoreFile("test-tts-settings")
+    }
+    private val appScope = AppScope()
+    private val settingsStore = SettingsStore(context, appScope, dataStore)
+    private val ttsManager = TTSManager(context)
+    private val tool = buildTtsTool(AppEventBus(), ttsManager, settingsStore)
+    private val workers = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    private lateinit var securityProvider: SyntheticSettingsSecurityProvider
+
+    /**
+     * Pump Android Main while real DataStore work proceeds on IO.
+     * SettingsStore 的初始化收集器跑在 AppScope（Dispatchers.Main）上，
+     * Robolectric 下 Main looper 默认暂停，裸 runBlocking 会等初始化等到天荒地老；
+     * 挂起操作放 IO 协程跑、主线程循环 idle Main looper 才能推进。
+     */
+    private fun <T> perform(block: suspend () -> T): Result<T> {
+        val task = workers.async { block() }
+        val deadline = System.nanoTime() + 30_000_000_000L
+        while (!task.isCompleted && System.nanoTime() < deadline) {
+            shadowOf(Looper.getMainLooper()).idle()
+            Thread.sleep(5)
+        }
+        check(task.isCompleted) { "TTS settings operation timed out" }
+        return runCatching { runBlocking { task.await() } }
+    }
+
+    @Before
+    fun setUp() {
+        // 落盘要过 ProviderCredentialCipher，它读 AndroidKeyStore；
+        // Robolectric 下没有 AndroidKeyStore，用仓内既有的合成 fixture 代替
+        //（仅外部 key 来源是合成的，生产 AES-GCM 与 Base64 代码原样跑）。
+        securityProvider = SyntheticSettingsSecurityProvider()
+        Security.insertProviderAt(securityProvider, 1)
+        SyntheticSettingsKeyStore.key = KeyGenerator.getInstance("AES").apply { init(256) }.generateKey()
+        SyntheticSettingsKeyStore.unavailable = false
+        ProviderCredentialCipher.clearDegradedStateForTest()
+    }
+
+    @After
+    fun tearDown() {
+        workers.cancel()
+        dataStoreScope.cancel()
+        appScope.cancel()
+        SyntheticSettingsKeyStore.key = null
+        SyntheticSettingsKeyStore.unavailable = false
+        Security.removeProvider(securityProvider.name)
+    }
+
+    @Test
+    fun `default system provider injects no guidance`() {
+        val prompt = perform { tool.systemPrompt(Model(), emptyList()) }.getOrThrow()
+        assertEquals("", prompt)
+    }
+
+    @Test
+    fun `selected MiMo provider injects its tone guidance`() {
+        val mimo = TTSProviderSetting.MiMo()
+        perform {
+            settingsStore.update { current ->
+                current.copy(
+                    ttsProviders = current.ttsProviders + mimo,
+                    selectedTTSProviderId = mimo.id,
+                )
+            }
+        }.getOrThrow()
+        val prompt = perform { tool.systemPrompt(Model(), emptyList()) }.getOrThrow()
+        assertEquals(ttsManager.getPromptGuidance(mimo), prompt)
+        assertTrue(prompt.isNotBlank())
+    }
+}
