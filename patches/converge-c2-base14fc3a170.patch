+package me.rerere.ai.ui
+
+/**
+ * 工具输出截断原语：生成期（全文落盘 + 预览）、保留历史、diff 输出三处策略层共用。
+ *
+ * 各策略的上限口径与落盘/摘要行为仍由调用方决定；这里只收敛「超限时保留前 N 字符
+ * 并追加统一截断标记」这一段纯逻辑，避免三处各写各的标记与跨 part 预算。
+ */
+
+/** 统一的截断标记：内容被截断时追加在保留文本之后。 */
+const val TEXT_TRUNCATION_MARKER = "\n…[truncated]"
+
+/** diff 输出的总量截断标记，带上限数值。 */
+fun diffTruncationMarker(maxChars: Int): String = "…<diff truncated: exceeds $maxChars chars>"
+
+/**
+ * 单段文本截断：长度不超限时原样返回；超限时保留前 [limit] 字符并追加 [marker]。
+ */
+fun truncateText(
+    text: String,
+    limit: Int,
+    marker: String = TEXT_TRUNCATION_MARKER,
+): String {
+    if (limit < 0 || text.length <= limit) return text
+    return text.take(limit) + marker
+}
+
+/**
+ * 跨 Text part 按序取字符：非 Text part 原样保留；Text part 按出现顺序分享 [limit]
+ * 的预算；预算耗尽后丢弃后续 Text part，并在最后一个保留的 Text part 后追加 [marker]。
+ *
+ * 总长度不超限时原样返回原列表；截断时保留的 Text part 会复制一份（带原 metadata），
+ * 其余 part 保持同一实例。
+ */
+fun truncateTextParts(
+    parts: List<UIMessagePart>,
+    limit: Int,
+    marker: String = TEXT_TRUNCATION_MARKER,
+): List<UIMessagePart> {
+    val total = parts.filterIsInstance<UIMessagePart.Text>().sumOf { it.text.length }
+    if (total <= limit) return parts
+    var remaining = limit
+    var markerAppended = false
+    val kept =
+        parts.mapNotNull { part ->
+            val text = (part as? UIMessagePart.Text)?.text ?: return@mapNotNull part
+            if (remaining <= 0) return@mapNotNull null
+            val take = minOf(text.length, remaining)
+            remaining -= take
+            if (take < text.length) {
+                markerAppended = true
+                UIMessagePart.Text(text.take(take) + marker, part.metadata)
+            } else {
+                part
+            }
+        }
+    if (markerAppended) return kept
+    // 恰好在 part 边界处耗尽预算：标记追加到最后一个保留的 Text part。
+    val lastTextIndex = kept.indexOfLast { it is UIMessagePart.Text }
+    if (lastTextIndex < 0) return kept
+    return kept.mapIndexed { index, part ->
+        if (index == lastTextIndex) {
+            val textPart = part as UIMessagePart.Text
+            textPart.copy(text = textPart.text + marker)
+        } else {
+            part
+        }
+    }
+}
