diff --git a/mediagen/src/main/java/me/rerere/mediagen/provider/providers/openai/OpenAIVideoGeneration.kt b/mediagen/src/main/java/me/rerere/mediagen/provider/providers/openai/OpenAIVideoGeneration.kt
