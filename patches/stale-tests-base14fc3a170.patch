+                inputModalities = listOf(Modality.TEXT),
+                abilities =
+                    buildList {
+                        add(ModelAbility.TOOL)
+                        if ("thinking" in tags) add(ModelAbility.REASONING)
+                    },
+            )
+        }
+    }
