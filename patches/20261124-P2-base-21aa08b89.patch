+@Composable
+private fun QuarantinedFieldsSection(
+    quarantinedFields: List<QuarantinedField>,
+    snapshotFile: File?,
+    onClearRequest: (QuarantinedField) -> Unit,
+    onExportSnapshot: (File) -> Unit,
+) {
+    Column(
